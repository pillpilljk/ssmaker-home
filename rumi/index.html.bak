    <!-- ===================================================================
         [탭 5] 학력별 연계 교육 로드맵 (텍스트 수정 완료)
         =================================================================== -->
    <section id="tab-roadmap" class="tab-panel" style="display:none;">
      <div class="section-card">
        <div class="section-header">
          <div>
            <h2 class="section-title">
              <span class="ko-txt">🏫 학력별 연계 교육 로드맵</span>
              <span class="mn-txt">🏫 Насны ангилалд суурилсан сургалтын замын зураг</span>
            </h2>
            <p class="section-sub">
              <span class="ko-txt">언플러그드로 시작해 엔트리 블록코딩으로 완성되는 성장 단계별 컴퓨팅 교육 체계</span>
              <span class="mn-txt">Unplugged-аас эхлэн Entry блок кодчлолоор төгсөх насны онцлогт тохирсон компьютерийн шинжлэх ухааны сургалтын тогтолцоо</span>
            </p>
            <div class="mn-sub">🇲🇳 Нас, сэтгэхүйн хөгжилд нийцүүлэн Unplugged-аас Entry блок кодинг хүртэл холбосон замын зураг</div>
          </div>
        </div>

        <div class="roadmap-grid">
          <div class="roadmap-card rm-unplugged">
            <span class="rm-stage">Track 1 : Unplugged Physical Computing</span>
            <h3 class="rm-title">
              <span class="ko-txt">🧸 유치원 & 초등 저학년</span>
              <span class="mn-txt">🧸 Цэцэрлэг & Бага анги (4~9 нас)</span>
            </h3>
