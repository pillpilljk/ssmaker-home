        mongolActIntegratedTitle: "Хамгийн дөт замыг оновчлох төсөл",
        actIntegratedDesc: "A에서 B까지 가는 길은 여러 갈래입니다. 길게 돌아가는 경로가 아니라, 가장 버튼을 적게 누르는(최단 경로) 효율적인 알고리즘을 짜서 실행한 팀이 우승하는 문제해결 심화 게임입니다.",
        mongolActIntegratedDesc: "А цэгээс В цэг хүртэл олон салаа зам бий. Тойрох биш хамгийн цөөн товч дарах (хамгийн дөт) үр дүнтэй алгоритм зохиож гүйцэтгэсэн баг ялах асуудал шийдвэрлэх гүнзгийрүүлсэн тоглоом юм.",
        tip: "A4 라인 퍼즐(직진┃, T자┳, 십자➕) 타일로 아이들이 직접 보물섬 미로를 설계하고, 네비게이터가 보물 위치부터 거꾸로 역산해 코드를 적은 뒤 실행하는 최고의 융합 프로젝트입니다."
      }];

    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playEnsembleDemo(btn) {
      const ctx = getAudioContext();
      const notes = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00, 493.88, 523.25];
      let time = ctx.currentTime;
      btn.disabled = true;
      btn.innerHTML = "🎶 무지개 음계 연주 중...";

      notes.forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, time + idx * 0.18);
        gain.gain.setValueAtTime(0.3, time + idx * 0.18);
        gain.gain.exponentialRampToValueAtTime(0.001, time + idx * 0.18 + 0.16);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(time + idx * 0.18);
        osc.stop(time + idx * 0.18 + 0.17);
      });

      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = `<span class="ko-txt"><span>▶</span> 무지개 음계 들어보기</span><span class="mn-txt"><span>▶</span> Солонгын эгшиг сонсох</span>`;
      }, (notes.length * 0.18 + 0.2) * 1000);
    }

    function playThereminDemo(btn) {
      const ctx = getAudioContext();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      btn.disabled = true;
      btn.innerHTML = "🛸 우주 테레민 소리 출력 중...";

      osc.type = 'sine';
      const now = ctx.currentTime;
      osc.frequency.setValueAtTime(220, now);
      osc.frequency.exponentialRampToValueAtTime(950, now + 0.8);
      osc.frequency.exponentialRampToValueAtTime(180, now + 1.8);
      osc.frequency.exponentialRampToValueAtTime(550, now + 2.4);

      gain.gain.setValueAtTime(0.05, now);
      gain.gain.linearRampToValueAtTime(0.28, now + 0.3);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 2.5);

      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 2.5);

      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = `<span class="ko-txt"><span>▶</span> 테레민 우주 사운드 들어보기</span><span class="mn-txt"><span>▶</span> Теремин сансрын дуу сонсох</span>`;
      }, 2600);
    }

    
