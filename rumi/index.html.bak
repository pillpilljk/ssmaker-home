    <!-- ===================================================================
         [탭 1] 차시별 언플러그드 가이드 (유치원 & 초등 저학년)
         =================================================================== -->
    <section id="tab-curriculum" class="tab-panel active">
      
      <div style="background: #fffbeb; border: 1px solid #fef3c7; border-radius: var(--radius-md); padding: 16px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:1.8rem;">🧸</span>
          <div>
            <div style="font-weight: 800; color: #92400e; font-size: 1.05rem;">
              <span class="ko-txt">유치원 및 초등 저학년(1~3학년) 전용 언플러그드 커리큘럼</span>
              <span class="mn-txt">Цэцэрлэг ба бага анги (1~3-р анги)-д зориулсан Unplugged хөтөлбөр</span>
            </div>
            <div style="font-size: 0.86rem; color: #b45309;">
              <span class="ko-txt">컴퓨터 모니터 없이 본체 2버튼(SELECT/START)과 전용 조종기만으로 온몸으로 체득하는 피지컬 코딩!</span>
              <span class="mn-txt">Компьютергүйгээр төхөөрөмжийн 2 товч (SELECT/START) ба удирдлагаар биеэр мэдрэх биет кодчлол!</span>
            </div>
            <div class="mn-sub">🇲🇳 Цэцэрлэг, бага ангид зориулсан Unplugged хөтөлбөр: Мониторгүйгээр 2 товчлуур ба удирдлагаар суралцах биет кодинг!</div>
          </div>
        </div>
        <span class="badge-kinder">Target: 4~9 нас</span>
      </div>

      <!-- 언플러그드 내장 프로그램 모드 동작 방법 안내 카드 -->
      <div class="mode-operation-guide">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
          <h3 style="font-size:1.15rem; font-weight:800; color:var(--gray-900); display:flex; align-items:center; gap:8px;">
            <span>💡</span> 
            <span class="ko-txt">언플러그드 내장 프로그램 모드 동작 방법</span>
            <span class="mn-txt">Unplugged суулгагдсан програмын ажиллах заавар</span>
          </h3>
          <span style="font-size:0.8rem; background:#eff6ff; color:var(--primary); font-weight:700; padding:3px 10px; border-radius:var(--radius-full); border:1px solid #bfdbfe;">
            <span class="ko-txt">공통 조작 가이드</span>
            <span class="mn-txt">Нийтлэг заавар</span>
          </span>
        </div>
        <div class="mn-sub">🇲🇳 Руми төхөөрөмжийн суулгагдсан програмуудыг удирдах үндсэн 3 алхам</div>

        <p style="font-size:0.9rem; color:var(--gray-600); line-height:1.6;">
          <span class="ko-txt">루미보드는 별도의 PC나 스마트폰 연결 없이 본체의 <strong>전원 스위치, SELECT 스위치, START 버튼</strong>만으로 15가지 내장 프로그램을 즉시 탐색하고 실행합니다.</span>
          <span class="mn-txt">Руми нь компьютер эсвэл ухаалаг утас холболгүйгээр зөвхөн <strong>цахилгаан унтраалга, SELECT товчлуур, START товч</strong>-оор 15 суулгагдсан горимыг шууд сонгон ажиллуулна.</span>
        </p>

        <!-- 3단계 동작 방법 플로우 -->
        <div class="mode-steps-flow">
          <div class="mode-step-card">
            <span class="mode-step-num">STEP 1</span>
            <h4 style="font-size:0.96rem; font-weight:700; color:var(--gray-900); margin-bottom:4px;">
              <span class="ko-txt">전원 켜기</span>
              <span class="mn-txt">Асаах</span>
            </h4>
            <p style="font-size:0.85rem; color:var(--gray-600);">
              <span class="ko-txt">루미 본체 후면의 <strong>전원 스위치</strong>를 켭니다. 눈에 불이 들어오며 준비 완료 대기 상태가 됩니다.</span>
              <span class="mn-txt">Румигийн ард байрлах <strong>цахилгаан унтраалгыг</strong> асаана. Нүдний LED гэрэл асч бэлэн болно.</span>
            </p>
            <div class="mn-sub">🇲🇳 Алхам 1: Төхөөрөмжийн цахилгааныг асаах</div>
          </div>

          <div class="mode-step-card">
            <span class="mode-step-num" style="background:#0284c7;">STEP 2</span>
            <h4 style="font-size:0.96rem; font-weight:700; color:var(--gray-900); margin-bottom:4px;">
              <span class="ko-txt">SELECT 스위치로 모드 탐색</span>
              <span class="mn-txt">SELECT-ээр горим сонгох</span>
            </h4>
            <p style="font-size:0.85rem; color:var(--gray-600);">
              <span class="ko-txt"><strong>SELECT</strong> 스위치를 1회 누를 때마다 <strong>LED 색상</strong>과 <strong>음계 소리(도레미파...)</strong>가 1단계씩 증가하며 모드가 변경됩니다. <em>(계속 누르면 1번 모드부터 다시 순환)</em></span>
              <span class="mn-txt"><strong>SELECT</strong> товчийг 1 удаа дарах бүрт <strong>LED өнгө</strong> ба <strong>хөгийн авиа (До-Ре-Ми-Фа...)</strong> 1 шатаар нэмэгдэж горим солигдоно.</span>
            </p>
            <div class="mn-sub">🇲🇳 Алхам 2: SELECT дарж өнгө, дуугаар горимоо тааруулах</div>
          </div>

          <div class="mode-step-card">
            <span class="mode-step-num" style="background:#16a34a;">STEP 3</span>
            <h4 style="font-size:0.96rem; font-weight:700; color:var(--gray-900); margin-bottom:4px;">
              <span class="ko-txt">START 버튼으로 즉시 실행</span>
              <span class="mn-txt">START-аар шууд эхлүүлэх</span>
            </h4>
            <p style="font-size:0.85rem; color:var(--gray-600);">
              <span class="ko-txt">원하는 모드의 색상/소리가 확인되면 <strong>START</strong> 버튼을 누릅니다. 즉시 재미있는 언플러그드 활동이 시작됩니다!</span>
              <span class="mn-txt">Хүссэн горимын өнгө, дуу таарсан бол <strong>START</strong> товчийг дарна. Тэр даруй сонирхолтой Unplugged даалгавар эхэлнэ!</span>
            </p>
            <div class="mn-sub">🇲🇳 Алхам 3: START товч дарж ажиллуулах</div>
          </div>
        </div>

        <!-- 16단계 피드백 순환표 -->
        <div style="background:#f8fafc; border:1px solid var(--gray-200); border-radius:var(--radius-sm); padding:14px;">
          <div style="font-size:0.85rem; font-weight:800; color:var(--gray-700); margin-bottom:6px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px;">
            <span>
              <span class="ko-txt">🎵 SELECT 누를 때마다 순환하는 16가지 LED 색상 & 음계 피드백 순서표</span>
              <span class="mn-txt">🎵 SELECT дарах бүрт солигдох 16 төрлийн LED өнгө & хөгийн дараалал</span>
            </span>
            <span style="font-size:0.75rem; color:var(--gray-500); font-weight:500;">
              <span class="ko-txt">(도레미파솔라시도 ➔ 높은음 도레미파솔라시도 ➔ 1번으로 순환)</span>
              <span class="mn-txt">(До-Ре-Ми-Фа-Соль-Ла-Си-До ➔ Өндөр До-Ре-Ми... ➔ 1 рүү дахин эхлэх)</span>
            </span>
          </div>
          <div class="mn-sub">🇲🇳 SELECT дарах бүрт өнгө ба ноот солигдох 16 алхамт хүснэгт</div>

          <div class="mode-sequence-grid">
            <div class="mode-seq-item">
              <span class="seq-color-chip" style="background:#ef4444;"></span>
              <strong><span class="ko-txt">모드 1</span><span class="mn-txt">Горим 1</span></strong>
              <span><span class="ko-txt">빨강</span><span class="mn-txt">Улаан</span></span>
              <span style="color:#2563eb; font-weight:700;"><span class="ko-txt">'도'</span><span class="mn-txt">'До'</span></span>
              <span class="mn-sub inline">🇲🇳 Горим 1 (Улаан, До)</span>
            </div>
            <div class="mode-seq-item">
              <span class="seq-color-chip" style="background:#f97316;"></span>
              <strong><span class="ko-txt">모드 2</span><span class="mn-txt">Горим 2</span></strong>
              <span><span class="ko-txt">주황</span><span class="mn-txt">Улбар шар</span></span>
              <span style="color:#2563eb; font-weight:700;"><span class="ko-txt">'레'</span><span class="mn-txt">'Ре'</span></span>
              <span class="mn-sub inline">🇲🇳 Горим 2 (Улбар шар, Ре)</span>
            </div>
            <div class="mode-seq-item">
              <span class="seq-color-chip" style="background:#eab308;"></span>
              <strong><span class="ko-txt">모드 3</span><span class="mn-txt">Горим 3</span></strong>
              <span><span class="ko-txt">노랑</span><span class="mn-txt">Шар</span></span>
              <span style="color:#2563eb; font-weight:700;"><span class="ko-txt">'미'</span><span class="mn-txt">'Ми'</span></span>
              <span class="mn-sub inline">🇲🇳 Горим 3 (Шар, Ми)</span>
            </div>
            <div class="mode-seq-item">
              <span class="seq-color-chip" style="background:#22c55e;"></span>
              <strong><span class="ko-txt">모드 4</span><span class="mn-txt">Горим 4</span></strong>
              <span><span class="ko-txt">초록</span><span class="mn-txt">Ногоон</span></span>
              <span style="color:#2563eb; font-weight:700;"><span class="ko-txt">'파'</span><span class="mn-txt">'Фа'</span></span>
              <span class="mn-sub inline">🇲🇳 Горим 4 (Ногоон, Фа)</span>
            </div>
            <div class="mode-seq-item">
              <span class="seq-color-chip" style="background:#3b82f6;"></span>
              <strong><span class="ko-txt">모드 5</span><span class="mn-txt">Горим 5</span></strong>
              <span><span class="ko-txt">파랑</span><span class="mn-txt">Цэнхэр</span></span>
              <span style="color:#2563eb; font-weight:700;"><span class="ko-txt">'솔'</span><span class="mn-txt">'Соль'</span></span>
              <span class="mn-sub inline">🇲🇳 Горим 5 (Цэнхэр, Соль)</span>
            </div>
            <div class="mode-seq-item">
              <span class="seq-color-chip" style="background:#1d4ed8;"></span>
              <strong><span class="ko-txt">모드 6</span><span class="mn-txt">Горим 6</span></strong>
              <span><span class="ko-txt">남색</span><span class="mn-txt">Хөх</span></span>
              <span style="color:#2563eb; font-weight:700;"><span class="ko-txt">'라'</span><span class="mn-txt">'Ла'</span></span>
              <span class="mn-sub inline">🇲🇳 Горим 6 (Хөх, Ла)</span>
            </div>
            <div class="mode-seq-item">
              <span class="seq-color-chip" style="background:#a855f7;"></span>
              <strong><span class="ko-txt">모드 7</span><span class="mn-txt">Горим 7</span></strong>
              <span><span class="ko-txt">보라</span><span class="mn-txt">Нил ягаан</span></span>
              <span style="color:#2563eb; font-weight:700;"><span class="ko-txt">'시'</span><span class="mn-txt">'Си'</span></span>
