    function renderAccordion(data) {
      const container = document.getElementById("accordionContainer");
      const emptyState = document.getElementById("emptyState");

      if (data.length === 0) {
        container.innerHTML = "";
        emptyState.classList.add("show");
        return;
      }
      emptyState.classList.remove("show");

      container.innerHTML = data.map((item, index) => {
        const isOpen = index === 0 ? "open" : "";
        
        let soundDemoHtml = "";
        if (item.hasSoundDemo) {
          if (item.soundType === "ensemble") {
            soundDemoHtml = `
              <div class="interactive-sound-box">
                <span style="font-size:0.85rem; color:#6b21a8; font-weight:600;">
                  <span class="ko-txt">🎹 모드 10 무선 건반 소리 체험 (Web Audio)</span>
                  <span class="mn-txt">🎹 Горим 10 Утасгүй даралтат хөгжим (Web Audio)</span>
                </span>
                <button class="sound-demo-btn" onclick="playEnsembleDemo(this)">
                  <span class="ko-txt"><span>▶</span> 무지개 음계 들어보기</span>
                  <span class="mn-txt"><span>▶</span> Солонгын эгшиг сонсох</span>
                </button>
              </div>
            `;
          } else if (item.soundType === "theremin") {
            soundDemoHtml = `
              <div class="interactive-sound-box">
                <span style="font-size:0.85rem; color:#6b21a8; font-weight:600;">
                  <span class="ko-txt">🛸 모드 11 거리-주파수 변환 테레민 소리 체험</span>
                  <span class="mn-txt">🛸 Горим 11 Зай-давтамжийн Теремин хөгжим</span>
                </span>
                <button class="sound-demo-btn" onclick="playThereminDemo(this)">
                  <span class="ko-txt"><span>▶</span> 테레민 우주 사운드 들어보기</span>
                  <span class="mn-txt"><span>▶</span> Теремин сансрын дуу сонсох</span>
                </button>
              </div>
            `;
          }
        }

        let remoconBlockHtml = "";
        if (item.remoconDetails) {
          const mnR = item.mongolRemoconDetails || {};
          remoconBlockHtml = `
            <div class="detail-block block-remocon">
              <div class="detail-label">
                <span>🎮</span>
                <span class="ko-txt">조종기 버튼 매핑 & 주행 가이드 (교재 18~19차시 매뉴얼)</span>
                <span class="mn-txt">Удирдлагын товчлуурын хуваарилалт & замын заавар</span>
              </div>
              <div class="detail-text" style="display:flex; flex-direction:column; gap:8px;">
                <div style="display:flex; flex-wrap:wrap; gap:14px; align-items:center;">
                  <div style="max-width:200px; background:white; padding:6px; border-radius:8px; border:1px solid #e9d5ff; text-align:center;">
                    <img src="image/005.png" alt="조종기 버튼" style="width:100%; height:auto; max-height:120px; object-fit:contain;">
                  </div>
                  <div style="flex:1; min-width:220px; background:white; padding:10px 14px; border-radius:6px; border:1px solid #e9d5ff; font-weight:700; color:#6b21a8; line-height:1.5;">
                    <span class="ko-txt">${item.remoconDetails.step1}</span>
                    <span class="mn-txt">${mnR.step1 || item.remoconDetails.step1}</span>
                  </div>
                </div>
                ${item.remoconDetails.rc ? `
                <div style="padding-left:4px;">
                  <span class="ko-txt">${item.remoconDetails.rc}</span>
                  <span class="mn-txt">${mnR.rc || item.remoconDetails.rc}</span>
                </div>` : ''}
                <div style="padding-left:4px;">
                  <span class="ko-txt">${item.remoconDetails.save}</span>
                  <span class="mn-txt">${mnR.save || item.remoconDetails.save}</span>
                </div>
                <div style="padding-left:4px;">
                  <span class="ko-txt">${item.remoconDetails.run}</span>
                  <span class="mn-txt">${mnR.run || item.remoconDetails.run}</span>
                </div>
                <div style="padding-left:4px;">
                  <span class="ko-txt">${item.remoconDetails.reset}</span>
                  <span class="mn-txt">${mnR.reset || item.remoconDetails.reset}</span>
                </div>
              </div>
            </div>
          `;
        }

        let remoteGuideHtml = "";
        if (item.hasRemoteGuide && item.remoteGuide) {
          const rg = item.remoteGuide;
          remoteGuideHtml = `
            <div class="detail-block block-remote-guide">
              <div class="detail-label">
                <span>🎮</span>
                <span class="ko-txt">2.4GHz 무선 조종기 페어링(Pairing) 및 상·하·좌·우 실시간 조작 가이드</span>
                <span class="mn-txt">2.4GHz Утасгүй удирдлагын хослолт (Pairing) ба бодит цагийн удирдлагын заавар</span>
              </div>
              <div class="mn-sub">🇲🇳 2.4GHz Удирдлагатай анх холбогдох 3 алхам ба чиглэлийн товчлуурын тайлбар</div>

              <!-- 이미지 + 페어링 안내 2컬럼 레이아웃 -->
              <div style="display:flex; flex-wrap:wrap; gap:20px; align-items:center; margin-bottom:18px;">
                <div style="flex: 1 1 280px; max-width:380px; background:white; border:1px solid #e9d5ff; border-radius:10px; padding:12px; text-align:center; box-shadow:0 2px 8px rgba(147,51,234,0.08);">
                  <img src="${rg.image}" alt="루미 2.4GHz 무선 조종기 버튼 매핑" style="width:100%; height:auto; max-height:220px; object-fit:contain; border-radius:6px;">
                  <div style="font-size:0.8rem; font-weight:700; color:#6b21a8; margin-top:8px;">
                    <span class="ko-txt">📷 루미 전용 무선 조종기 (버튼: LU, LD, LL, LR, L1, RU, RL, RR)</span>
                    <span class="mn-txt">📷 Руми зориулалтын утасгүй удирдлага (Товчлуурууд: LU, LD, LL, LR, L1, RU...)</span>
                  </div>
                </div>

                <div style="flex: 1 1 320px; display:flex; flex-direction:column; gap:10px;">
                  <div style="background:white; border:1px solid #f0abfc; border-radius:8px; padding:12px 14px; font-size:0.88rem; line-height:1.65; color:var(--gray-800);">
                    <div style="font-weight:800; color:#9333ea; margin-bottom:4px; display:flex; align-items:center; gap:6px;">
                      <span>💡</span>
                      <span class="ko-txt">한번 페어링되면 평생 자동 연결!</span>
                      <span class="mn-txt">Нэг удаа холбоход байнга санана!</span>
                    </div>
                    <span class="ko-txt">조종기와 루미는 <strong>한 번 페어링을 완료하면 내부 메모리에 영구 기억</strong>되므로, 다음 수업부터는 전원만 켜도 바로 자동 연결됩니다. <strong>처음 연결할 때만</strong> 아래의 1회 필수 페어링 절차를 진행합니다.</span>
                    <span class="mn-txt">Удирдлага ба Руми нь <strong>нэг удаа хослоход санах ойд хадгалагддаг</strong> тул дараагийн хичээлүүдэд зөвхөн асаахад л шууд холбогдоно. <strong>Зөвхөн анх удаа</strong> доорх хослох 3 алхмыг хийнэ.</span>
                  </div>

                  <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:10px 14px; font-size:0.85rem; color:#166534; line-height:1.6;">
                    🎮 <strong>
                      <span class="ko-txt">즉시 반응하는 원터치 실시간 조종:</span>
                      <span class="mn-txt">Нэг даралтаар шууд удирдах:</span>
                    </strong><br>
                    <span class="ko-txt">페어링이 완료되면 <strong>별도의 다른 버튼을 누르고 있을 필요 없이, 조종기 방향키(LU, LD, LL, LR)만 누르면 로봇이 즉각 반응</strong>하여 앞, 뒤, 좌, 우로 부드럽게 주행합니다!</span>
                    <span class="mn-txt">Хослолт амжилттай болсны дараа <strong>өөр ямар ч товч даралгүйгээр зөвхөн чиглэлийн товчлуурыг дарахад л</strong> урагш, хойш, зүүн, баруун тийш чөлөөтэй жолоодно!</span>
                  </div>
                </div>
              </div>

              <!-- 페어링 3단계 상세 스텝 -->
              <div style="margin-bottom:16px;">
                <div style="font-weight:800; color:#6b21a8; font-size:0.92rem; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                  <span>🔗</span>
                  <span class="ko-txt">처음 1회 필수! 루미 & 조종기 무선 페어링(Pairing) 3단계 절차</span>
                  <span class="mn-txt">Анхны 1 удаагийн заавал хийх утасгүй хослолын 3 алхам</span>
                </div>
                <div class="remote-pairing-flow">
                  <div class="remote-pairing-step" style="border-top:3px solid #0284c7;">
                    <div style="font-weight:800; color:#0369a1; margin-bottom:4px;">
                      <span class="ko-txt">1. 루미(로봇) 페어링 모드</span>
                      <span class="mn-txt">1. Руми хослох горим</span>
                    </div>
                    <div>
                      <span class="ko-txt">루미 전원을 켠 상태에서 <strong>SELECT 버튼을 3초간 길게 누릅니다</strong>. ➔ "삐빅~" 소리와 함께 <strong>파란색 LED가 깜박입니다</strong>.</span>
                      <span class="mn-txt">Румиг асаагаад <strong>SELECT товчийг 3 секунд удаан дарна</strong>. ➔ Дуу гарч <strong>цэнхэр LED анивчина</strong>.</span>
                    </div>
                  </div>
                  <div class="remote-pairing-step" style="border-top:3px solid #d946ef;">
                    <div style="font-weight:800; color:#a21caf; margin-bottom:4px;">
                      <span class="ko-txt">2. 조종기 페어링 모드</span>
                      <span class="mn-txt">2. Удирдлага хослох горим</span>
                    </div>
                    <div>
                      <span class="ko-txt">조종기의 <strong>L1 버튼을 누른 채 전원 스위치를 켭니다</strong>. ➔ <strong>조종기 상단 LED가 깜박입니다</strong>.</span>
                      <span class="mn-txt">Удирдлагын <strong>L1 товчийг дарангаа цахилгааныг асаана</strong>. ➔ <strong>Удирдлагын дээд LED анивчина</strong>.</span>
                    </div>
                  </div>
                  <div class="remote-pairing-step" style="border-top:3px solid #16a34a;">
                    <div style="font-weight:800; color:#15803d; margin-bottom:4px;">
                      <span class="ko-txt">3. 자동 매칭 & 완료</span>
                      <span class="mn-txt">3. Автомат холболт & Дуусах</span>
                    </div>
                    <div>
                      <span class="ko-txt">서로 주파수를 감지하여 1:1 매칭되면 <strong>양쪽 LED 깜박임이 종료</strong>되고 정상 연결됩니다!</span>
                      <span class="mn-txt">Бие биенээ мэдэрч 1:1 холбогдмогц <strong>хоёр талын LED анивчихаа больж</strong> бэлэн болно!</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 버튼별 기능 매핑표 -->
              <div>
                <div style="font-weight:800; color:#6b21a8; font-size:0.92rem; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                  <span>🕹️</span>
                  <span class="ko-txt">조종기 버튼별 기능 및 실시간(RC) 주행 매핑표</span>
                  <span class="mn-txt">Удирдлагын товчлуур тус бүрийн үүрэг ба бодит цагийн (RC) удирдлагын хүснэгт</span>
                </div>
                <div class="remote-ctrl-grid">
                  ${rg.controls.map(c => `
                    <div class="remote-ctrl-key">
                      <div style="display:flex; align-items:center; justify-content:space-between;">
                        <span style="font-weight:800; color:#6b21a8; background:#f3e8ff; padding:2px 8px; border-radius:4px;">${c.key}</span>
                        <strong style="color:var(--gray-900); font-size:0.83rem;">
                          <span class="ko-txt">${c.name}</span>
                          <span class="mn-txt">${c.mongolName || c.name}</span>
                        </strong>
                      </div>
                      <div style="color:var(--gray-600); font-size:0.79rem; line-height:1.45;">
                        <span class="ko-txt">${c.desc}</span>
                        <span class="mn-txt">${c.mongolDesc || c.desc}</span>
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>

            </div>
          `;
        }

        let videoBlockHtml = "";
        if (item.videoId) {
          const ratioClass = (item.videoRatio === "16/9") ? "landscape" : "portrait";
          const ratioBadge = (item.videoRatio === "16/9") ? "16:9 와이드" : "9:16 쇼츠";
          const ytUrl = `https://youtu.be/${item.videoId}`;
          videoBlockHtml = `
            <div class="detail-block block-video">
              <div class="detail-label" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <div style="display:flex; align-items:center; gap:8px;">
                  <span style="font-size:1.15rem;">🎬</span>
                  <span style="font-weight:800; color:#991b1b;">
                    <span class="ko-txt">실제 로봇 동작 시연 영상 (Video Demonstration)</span>
                    <span class="mn-txt">Бодит ажиллагааны бичлэг (Video Demonstration)</span>
                  </span>
                  <span class="video-ratio-pill">${ratioBadge}</span>
                </div>
                <a href="${ytUrl}" target="_blank" rel="noopener noreferrer" class="yt-pill-btn" title="새 창에서 유튜브로 열기">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="#ef4444"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  <span>
                    <span class="ko-txt">YouTube에서 보기 ↗</span>
                    <span class="mn-txt">YouTube дээр үзэх ↗</span>
                  </span>
                </a>
              </div>
              <div class="video-player-wrap ${ratioClass}">
                <iframe 
                  src="https://www.youtube.com/embed/${item.videoId}?enablejsapi=1&playsinline=1&rel=0" 
                  title="${item.title} 실제 시연 영상" 
                  frameborder="0"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen>
                </iframe>
              </div>
              <div class="file-protocol-notice" style="display: ${window.location.protocol === 'file:' ? 'block' : 'none'}; background:#fff1f2; border:1px solid #fecdd3; border-radius:8px; padding:10px 14px; margin-top:8px; font-size:0.83rem; color:#9f1239; line-height:1.55;">
                <div style="font-weight:800; display:flex; align-items:center; gap:6px; margin-bottom:2px;">
                  <span>💡</span>
                  <span class="ko-txt">동영상 플레이어 구성 오류(153)가 발생하시나요?</span>
                  <span class="mn-txt">Бичлэг тоглуулагчийн 153-р алдаа гарч байна уу?</span>
                </div>
                <div>
                  <span class="ko-txt">Chrome/Edge 등 브라우저의 <strong>로컬 파일(file://) 보안 정책</strong>으로 인해 YouTube가 임베드 재생을 차단한 경우입니다. 상단 우측의 <strong>[YouTube에서 보기 ↗]</strong> 버튼을 누르시면 즉시 고화질로 시청하실 수 있으며, 프로젝트 폴더의 <strong>'웹앱_실행.bat'</strong>을 실행하시면 웹앱 내부에서도 오류 없이 바로 재생됩니다!</span>
                  <span class="mn-txt">Хөтчийн <strong>file://</strong> аюулгүй байдлын бодлогоос үүдэлтэй алдаа юм. Дээрх <strong>[YouTube дээр үзэх ↗]</strong> товчийг дарж үзнэ үү, эсвэл <strong>'웹앱_실행.bat'</strong>-аар серверийг асааж үзнэ үү!</span>
                </div>
              </div>
              <div class="video-caption-box">
                <span style="font-size:1rem;">📌</span>
                <span class="ko-txt">${item.videoDesc || item.videoTitle}</span>
                <span class="mn-txt">${item.mongolOperation || item.mongolTitle}</span>
                <div class="mn-sub">🇲🇳 ${item.mongolTitle} бичлэг</div>
              </div>
            </div>
          `;
        }

        
        let activitiesBlockHtml = "";
        if (item.eduGoal) {
          const mnEduGoal = item.mongolEduGoal || item.eduGoal;
          const mnBasicTitle = item.mongolActBasicTitle || item.actBasicTitle;
          const mnBasicDesc = item.mongolActBasicDesc || item.actBasicDesc;
          const mnAppliedTitle = item.mongolActAppliedTitle || item.actAppliedTitle;
          const mnAppliedDesc = item.mongolActAppliedDesc || item.actAppliedDesc;
          const mnIntegratedTitle = item.mongolActIntegratedTitle || item.actIntegratedTitle;
          const mnIntegratedDesc = item.mongolActIntegratedDesc || item.actIntegratedDesc;

          activitiesBlockHtml = `
            <!-- 🎯 3단계 차시별 실전 활동 (기본/응용/융합) & 교육 목표 -->
            <div class="detail-block block-three-activities">
              <div class="detail-label" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <div style="display:flex; align-items:center; gap:8px;">
                  <span style="font-size:1.15rem;">🎯</span>
                  <span style="font-weight:800; color:#3730a3;">
                    <span class="ko-txt">차시별 3단계 실전 수업 활동 가이드 (Activity Guide)</span>
                    <span class="mn-txt">Хичээлийн 3 үе шаттай бодит дадлага хөтөлбөр (Activity Guide)</span>
                  </span>
                </div>
                <span class="act-guide-badge">
                  <span class="ko-txt">💡 기본 • 응용 • 융합 3단계 맞춤 활동</span>
                  <span class="mn-txt">💡 Суурь • Хэрэглээ • Интеграц 3 үе шат</span>
                </span>
              </div>
              <div class="mn-sub">🇲🇳 Суурь, хэрэглээ, интеграц 3 үе шаттай бодит хичээлийн дадлага ба сургалтын зорилго</div>

              <!-- 💡 교육 목표 -->
              <div class="edu-goal-box">
                <div class="edu-goal-title">
                  <span>💡</span>
                  <span class="ko-txt">교육 목표:</span>
                  <span class="mn-txt">Сургалтын зорилго:</span>
                </div>
                <div class="edu-goal-desc">
                  <span class="ko-txt">${item.eduGoal}</span>
                  <span class="mn-txt">${mnEduGoal}</span>
                  <div class="mn-sub" style="margin-top:4px;">🇲🇳 ${mnEduGoal}</div>
                </div>
              </div>

              <!-- 3가지 활동 카드 그리드 -->
              <div class="act-cards-grid">
                <!-- 1. 기본 활동 -->
                <div class="act-card-item basic">
                  <div class="act-tier-header">
                    <span class="act-tier-pill basic">
                      <span>🟢</span>
                      <span class="ko-txt">[기본 활동]</span>
                      <span class="mn-txt">[Суурь дадлага]</span>
                    </span>
                  </div>
                  <div class="act-title-text">
                    <span class="ko-txt">${item.actBasicTitle}</span>
                    <span class="mn-txt">${mnBasicTitle}</span>
                  </div>
                  <div class="act-desc-text">
                    <span class="ko-txt">${item.actBasicDesc}</span>
                    <span class="mn-txt">${mnBasicDesc}</span>
                  </div>
                  <div class="mn-sub">🇲🇳 <strong>${mnBasicTitle}</strong>: ${mnBasicDesc}</div>
                </div>

                <!-- 2. 응용 활동 -->
                <div class="act-card-item applied">
                  <div class="act-tier-header">
                    <span class="act-tier-pill applied">
                      <span>🟠</span>
                      <span class="ko-txt">[응용 활동]</span>
                      <span class="mn-txt">[Хэрэглээний дадлага]</span>
                    </span>
                  </div>
                  <div class="act-title-text">
                    <span class="ko-txt">${item.actAppliedTitle}</span>
                    <span class="mn-txt">${mnAppliedTitle}</span>
                  </div>
                  <div class="act-desc-text">
                    <span class="ko-txt">${item.actAppliedDesc}</span>
                    <span class="mn-txt">${mnAppliedDesc}</span>
                  </div>
                  <div class="mn-sub">🇲🇳 <strong>${mnAppliedTitle}</strong>: ${mnAppliedDesc}</div>
                </div>

                <!-- 3. 융합 활동 -->
                <div class="act-card-item integrated">
                  <div class="act-tier-header">
                    <span class="act-tier-pill integrated">
                      <span>🟣</span>
                      <span class="ko-txt">[융합 활동]</span>
                      <span class="mn-txt">[Интеграц дадлага]</span>
                    </span>
                  </div>
                  <div class="act-title-text">
                    <span class="ko-txt">${item.actIntegratedTitle}</span>
                    <span class="mn-txt">${mnIntegratedTitle}</span>
                  </div>
                  <div class="act-desc-text">
                    <span class="ko-txt">${item.actIntegratedDesc}</span>
                    <span class="mn-txt">${mnIntegratedDesc}</span>
                  </div>
                  <div class="mn-sub">🇲🇳 <strong>${mnIntegratedTitle}</strong>: ${mnIntegratedDesc}</div>
                </div>
              </div>
            </div>
          `;
        }

        return `
          <div class="accordion-item ${isOpen}" data-unit="${item.unit}" data-id="${item.id}">
            <button class="accordion-header" type="button" aria-expanded="${isOpen === 'open' ? 'true' : 'false'}">
              <div class="header-left">
                <div class="lesson-mode-badge">
                  <span class="mode-sub">MODE</span>
                  <span class="mode-num">${item.modeNum}</span>
                </div>
                <div class="lesson-meta">
                  <div class="lesson-unit">
                    <span>📚 ${item.unitFull}</span>
                    <span style="color:var(--gray-400);">•</span>
                    <span>${item.modeText}</span>
                    ${item.videoId ? `<span class="has-video-tag"><span class="ko-txt">🎬 영상 재생</span><span class="mn-txt">🎬 Бичлэг үзэх</span></span>` : ''}
                  </div>
                  <div class="lesson-title-text">
                    <span class="ko-txt">${item.title}</span>
                    <span class="mn-txt">${item.mongolTitle}</span>
                  </div>
                  <div class="mn-sub inline">🇲🇳 ${item.mongolTitle}</div>
                </div>
              </div>
              <div class="header-right">
                <div class="accordion-icon" aria-hidden="true">▼</div>
              </div>
            </button>
            <div class="accordion-collapse">
              <div class="accordion-body">
                <div class="accordion-content">
                  
                  <!-- 모드 선택 피드백 & 실제 하드웨어 동작 가이드 -->
                  <div class="detail-block block-action">
                    <div class="detail-label">
                      <span>🎮</span>
                      <span class="ko-txt">모드 선택 피드백 및 실제 동작 방법 (Operation Guide)</span>
                      <span class="mn-txt">Горим сонголтын хариу үйлдэл ба бодит ажиллах заавар (Operation Guide)</span>
                    </div>
                    <div class="detail-text" style="display:flex; flex-direction:column; gap:8px;">
                      <div style="background:white; padding:10px 14px; border-radius:8px; border:1px solid #99f6e4; font-weight:700; color:#0f766e; display:flex; align-items:flex-start; gap:8px;">
                        <span style="font-size:1.1rem; line-height:1.2;">🔔</span>
                        <div style="line-height:1.5;">
                          <span class="ko-txt">${item.selectFeedback}</span>
                          <span class="mn-txt">${item.mongolFeedback || item.selectFeedback}</span>
                          <div class="mn-sub">🇲🇳 ${item.mongolFeedback || ''}</div>
                        </div>
                      </div>
                      <div style="line-height:1.65; color:var(--gray-800); padding:2px 4px;">
                        <strong style="color:#0f766e;">
                          <span class="ko-txt">▶ 하드웨어 실제 동작 메커니즘:</span>
                          <span class="mn-txt">▶ Төхөөрөмжийн бодит ажиллах зарчим:</span>
                        </strong> 
                        <span class="ko-txt">${item.operationMethod}</span>
                        <span class="mn-txt">${item.mongolOperation || item.operationMethod}</span>
                        <div class="mn-sub">🇲🇳 ${item.mongolOperation || ''}</div>
                      </div>
                    </div>
                  </div>

                  ${remoteGuideHtml}

                  ${videoBlockHtml}

                  
                  ${activitiesBlockHtml}

                  <!-- 선생님을 위한 교육적 발문 & 확장 놀이 꿀팁 -->
                  <div class="detail-block block-teacher">
                    <div class="detail-label" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                      <div style="display:flex; align-items:center; gap:8px;">
                        <span style="font-size:1.15rem;">👩‍🏫</span>
                        <span style="font-weight:800; color:#c2410c;">
                          <span class="ko-txt">선생님을 위한 교육적 발문 & 확장 놀이 꿀팁</span>
                          <span class="mn-txt">Багшид зориулсан сурган хүмүүжүүлэх асуулт & Өргөтгөсөн тоглоом</span>
                        </span>
                      </div>
                      <span class="teacher-edu-badge">
                        <span class="ko-txt">💡 유아/초등 저학년 교육 가이드</span>
                        <span class="mn-txt">💡 Бага насны боловсролын зөвлөмж</span>
                      </span>
                    </div>
                    <div class="mn-sub">🇲🇳 Багшийн чиглүүлэх асуулт ба урлаг, биеийн тамир, математиктай холбосон тоглоомын санаа</div>

                    <div style="display:flex; flex-direction:column; gap:10px; margin-top:8px;">
                      <!-- 1. 교육적 의미 -->
                      <div class="teacher-meaning-box">
                        <div style="font-weight:800; color:#ea580c; font-size:0.86rem; display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                          <span>🎯</span>
                          <span class="ko-txt">교육적 의미 (핵심 역량):</span>
                          <span class="mn-txt">Сурган хүмүүжүүлэх ач холбогдол (Үндсэн ур чадвар):</span>
                        </div>
                        <div style="font-size:0.88rem; line-height:1.6; color:#9a3412;">
                          <span class="ko-txt">${item.eduMeaning || ''}</span>
                          <span class="mn-txt">${item.mongolEduMeaning || item.eduMeaning || ''}</span>
                          <div class="mn-sub">🇲🇳 ${item.mongolEduMeaning || ''}</div>
                        </div>
                      </div>

                      <!-- 2. 선생님 발문 예시 (도입) -->
                      <div class="teacher-speech-box">
                        <div style="font-weight:800; color:#b45309; font-size:0.86rem; display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                          <span>💬</span>
                          <span class="ko-txt">선생님 발문 예시 (수업 도입):</span>
                          <span class="mn-txt">Багшийн асуултын жишээ (Хичээлийн эхлэл):</span>
                        </div>
                        <div class="teacher-dialogue">
                          <span class="ko-txt">${item.teacherPrompt || ''}</span>
                          <span class="mn-txt">${item.mongolTeacherPrompt || item.teacherPrompt || ''}</span>
                          <div class="mn-sub">🇲🇳 ${item.mongolTeacherPrompt || ''}</div>
                        </div>
                      </div>

                      <!-- 3. 확장 놀이 -->
                      <div class="extension-act-box">
                        <div style="font-weight:800; color:#15803d; font-size:0.86rem; display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                          <span>🎨</span>
                          <span class="ko-txt">확장 놀이 아이디어 (교과/신체 연계):</span>
                          <span class="mn-txt">Өргөтгөсөн тоглоомын санаа (Хичээл хоорондын холбоо):</span>
                        </div>
                        <div style="font-size:0.88rem; line-height:1.6; color:#14532d;">
                          <span class="ko-txt">${item.extensionActivity || ''}</span>
                          <span class="mn-txt">${item.mongolExtensionActivity || item.extensionActivity || ''}</span>
                          <div class="mn-sub">🇲🇳 ${item.mongolExtensionActivity || ''}</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="detail-block block-principle">
                    <div class="detail-label">
                      <span>⚙️</span>
                      <span class="ko-txt">핵심 원리 (Computer Science Principle)</span>
                      <span class="mn-txt">Үндсэн зарчим (Computer Science Principle)</span>
                    </div>
                    <div class="detail-text">
                      <strong class="ko-txt">${item.principle}</strong>
                      <strong class="mn-txt">${item.mongolPrinciple}</strong>
                      <div class="mn-sub">🇲🇳 ${item.mongolPrinciple}</div>
                    </div>
                  </div>

                  <div class="detail-block block-story">
                    <div class="detail-label">
                      <span>🗣️</span>
                      <span class="ko-txt">교실 속 스토리텔링 (Storytelling Guide)</span>
                      <span class="mn-txt">Анги дахь өгүүллэг (Storytelling Guide)</span>
                    </div>
                    <div class="detail-text">
                      <blockquote class="story-quote">
                        <span class="ko-txt">${item.storytelling}</span>
                        <span class="mn-txt">${item.mongolStory || item.storytelling}</span>
                        <div class="mn-sub">🇲🇳 ${item.mongolStory || ''}</div>
                      </blockquote>
                    </div>
                  </div>

                  ${soundDemoHtml}
                  ${remoconBlockHtml}

                  <div class="detail-block block-guide">
                    <div class="detail-label">
                      <span>💡</span>
                      <span class="ko-txt">유치원·초등 저학년 교사용 수업 꿀팁 & 지도 가이드</span>
                      <span class="mn-txt">Цэцэрлэг, бага ангийн багшид зориулсан хичээлийн зөвлөмж</span>
                    </div>
                    <div class="detail-text">
                      <span class="ko-txt">${item.tip}</span>
                      <span class="mn-txt">${item.mongolTip || item.tip}</span>
                      <div class="mn-sub">🇲🇳 ${item.mongolTip || ''}</div>
                    </div>
                  </div>

                  <div class="lesson-hw-tags">
                    <span style="font-size:0.75rem; font-weight:700; color:var(--gray-500); margin-right:4px;"><span class="ko-txt">연계 하드웨어 & 개념:</span><span class="mn-txt">Төхөөрөмж ба ойлголт:</span></span>
                    ${item.sensors.map(s => {
                      const mn = tagTranslations[s] || s;
                      return `<span class="hw-tag sensor">📡 <span class="ko-txt">${s}</span><span class="mn-txt">${mn}</span></span>`;
                    }).join('')}
                    ${item.concepts.map(c => {
                      const mn = tagTranslations[c] || c;
                      return `<span class="hw-tag concept">🧠 <span class="ko-txt">${c}</span><span class="mn-txt">${mn}</span></span>`;
                    }).join('')}
                  </div>

                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');

      attachAccordionEvents();
    }

    function attachAccordionEvents() {
      const headers = document.querySelectorAll(".accordion-header");
      headers.forEach(header => {
        header.addEventListener("click", () => {
          const item = header.closest(".accordion-item");
          const isOpen = item.classList.contains("open");

          if (isOpen) {
            item.classList.remove("open");
            header.setAttribute("aria-expanded", "false");
            // 아코디언이 접힐 때 재생 중인 유튜브 영상 음성 및 재생 정지
            const iframes = item.querySelectorAll("iframe");
            iframes.forEach(f => {
              const src = f.src;
              f.src = src;
            });
          } else {
            item.classList.add("open");
            header.setAttribute("aria-expanded", "true");
          }
        });
      });
    }

    let activeUnit = "all";
    let searchQuery = "";

    function filterAndRender() {
      const filtered = lessonsData.filter(item => {
        let matchUnit = false;
        if (activeUnit === "all") {
          matchUnit = true;
        } else if (activeUnit === "video") {
          matchUnit = Boolean(item.videoId);
        } else {
          matchUnit = item.unit.includes(activeUnit);
        }
        
        const q = searchQuery.toLowerCase().trim();
        if (!q) return matchUnit;

        const isVideoSearch = (q === "영상" || q === "동영상" || q === "비디오" || q === "video" || q === "shorts" || q === "유튜브" || q === "youtube");

        const matchText = 
          item.title.toLowerCase().includes(q) ||
          item.mongolTitle.toLowerCase().includes(q) ||
          item.principle.toLowerCase().includes(q) ||
          item.storytelling.toLowerCase().includes(q) ||
          item.modeText.toLowerCase().includes(q) ||
          (item.operationMethod && item.operationMethod.toLowerCase().includes(q)) ||
          (item.selectFeedback && item.selectFeedback.toLowerCase().includes(q)) ||
          (item.videoId && isVideoSearch) ||
          (item.eduGoal && item.eduGoal.toLowerCase().includes(q)) ||
          (item.actBasicTitle && item.actBasicTitle.toLowerCase().includes(q)) ||
          (item.actAppliedTitle && item.actAppliedTitle.toLowerCase().includes(q)) ||
          (item.actIntegratedTitle && item.actIntegratedTitle.toLowerCase().includes(q)) ||
          item.sensors.some(s => s.toLowerCase().includes(q)) ||
          item.concepts.some(c => c.toLowerCase().includes(q));

        return matchUnit && matchText;
      });

      renderAccordion(filtered);
    }

    function switchToTab(tabId) {
      const navBtns = document.querySelectorAll(".nav-btn");
      const tabPanels = document.querySelectorAll(".tab-panel");

      navBtns.forEach(b => {
        const target = b.getAttribute("data-tab");
        if (target === tabId) {
          b.classList.add("active");
          if (b.classList.contains("curriculum-btn")) {
            if (tabId === "tab-curriculum") b.classList.add("unplugged");
            if (tabId === "tab-entry") b.classList.add("entry");
          }
        } else {
          b.classList.remove("active");
          b.classList.remove("unplugged");
          b.classList.remove("entry");
        }
      });

      tabPanels.forEach(p => {
        p.style.display = (p.id === tabId) ? "block" : "none";
      });
      window.scrollTo({ top: 320, behavior: 'smooth' });
    }

    document.addEventListener("DOMContentLoaded", () => {
      renderAccordion(lessonsData);

      const chips = document.querySelectorAll(".chip-btn");
      chips.forEach(chip => {
        chip.addEventListener("click", () => {
          chips.forEach(c => c.classList.remove("active"));
          chip.classList.add("active");
          activeUnit = chip.getAttribute("data-unit");
          filterAndRender();
        });
      });

      const searchInput = document.getElementById("lessonSearch");
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value;
        filterAndRender();
      });

      document.getElementById("expandAllBtn").addEventListener("click", () => {
        document.querySelectorAll(".accordion-item").forEach(item => {
          item.classList.add("open");
          item.querySelector(".accordion-header")?.setAttribute("aria-expanded", "true");
        });
      });

      document.getElementById("collapseAllBtn").addEventListener("click", () => {
        document.querySelectorAll(".accordion-item").forEach(item => {
          item.classList.remove("open");
          item.querySelector(".accordion-header")?.setAttribute("aria-expanded", "false");
          const iframes = item.querySelectorAll("iframe");
          iframes.forEach(f => {
            const src = f.src;
            f.src = src;
          });
        });
      });

      const subtitleBtn = document.getElementById("langSubtitleBtn");
      const convertBtn = document.getElementById("langConvertBtn");

      function updateLanguageUI() {
        const isFullMn = document.body.classList.contains("lang-mongol-full");
        const isSubOn = document.body.classList.contains("show-mongol-sub");

        if (convertBtn) {
          if (isFullMn) {
            convertBtn.innerHTML = `<span>🇰🇷</span> 한국어로 보기 (Солонгос хэл)`;
            convertBtn.classList.add("active");
          } else {
            convertBtn.innerHTML = `<span>🇲🇳</span> Монгол хэлээр харах`;
            convertBtn.classList.remove("active");
          }
        }

        if (subtitleBtn) {
          if (isFullMn) {
            subtitleBtn.innerHTML = isSubOn ? `<span>🌐</span> Монгол хадмал унтраах` : `<span>🌐</span> Монгол хадмал асаах`;
          } else {
            subtitleBtn.innerHTML = isSubOn ? `<span>🌐</span> 몽골어 보조자막 끄기` : `<span>🌐</span> 몽골어 보조자막 켜기`;
          }
          if (isSubOn) {
            subtitleBtn.classList.add("active");
          } else {
            subtitleBtn.classList.remove("active");
          }
        }

        const searchInput = document.getElementById("lessonSearch");
        if (searchInput) {
          searchInput.placeholder = isFullMn 
            ? "Хичээлийн нэр, зарчим, мэдрэгч, горимын дугаараар хайх (жишээ: теремин, санах ой, 12-р горим)..."
            : "차시 제목, 핵심 원리, 센서, 모드 번호 검색 (예: 테레민, 메모리, 모드 12, 역산, 오토센싱)...";
        }

        const expandBtn = document.getElementById("expandAllBtn");
        const collapseBtn = document.getElementById("collapseAllBtn");
        if (expandBtn) expandBtn.innerHTML = isFullMn ? `<span>📂</span> Бүгдийг дэлгэх` : `<span>📂</span> 모두 펼치기`;
        if (collapseBtn) collapseBtn.innerHTML = isFullMn ? `<span>📁</span> Бүгдийг хураах` : `<span>📁</span> 모두 접기`;
      }

      if (subtitleBtn) {
        subtitleBtn.addEventListener("click", () => {
          document.body.classList.toggle("show-mongol-sub");
          updateLanguageUI();
        });
      }

      if (convertBtn) {
        convertBtn.addEventListener("click", () => {
          document.body.classList.toggle("lang-mongol-full");
          updateLanguageUI();
        });
      }

      const navBtns = document.querySelectorAll(".nav-btn");
      navBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const targetTabId = btn.getAttribute("data-tab");
          switchToTab(targetTabId);
        });
      });
    });
  </script>
</body>
</html>
